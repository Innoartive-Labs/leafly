{
  "manifest_version": 3,
  "name": "Leafly - Ambient Weather & Nature Effects",
  "version": "1.0.0",
  "author": "Innoartive Labs",
  "description": "Subtle, ambient nature and weather effects with seasonal particles, gentle accumulation, and clean interactions.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png",
    "512": "assets/icons/icon-512.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png",
      "512": "assets/icons/icon-512.png"
    },
    "default_title": "Leafly - Nature Effects"
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/svg/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
